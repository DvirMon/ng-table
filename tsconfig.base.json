{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@acme/shared-design-system": [
        "./libs/shared/design-system/src/index.ts"
      ],
      "@acme/shared-design-system/styles": [
        "./libs/shared/design-system/src/styles/index.ts"
      ],
      "@acme/table": ["./libs/shared/table/src/index.ts"],
      "@acme/table/forms": ["./libs/shared/table/src/forms/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
