#!/bin/sh
# Reject commits on the default branch. Detached HEAD (mid-rebase) is allowed.
branch=$(git symbolic-ref --short -q HEAD) || exit 0
default=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')

for protected in main master $default; do
  if [ "$branch" = "$protected" ]; then
    echo "✋ Commit on '$branch' rejected — the default branch changes only through PRs." >&2
    echo "   Start a branch: git switch -c <type>/<issue#>-<slug>" >&2
    exit 1
  fi
done

# Format staged files and re-stage them. Falls back to the primary checkout's
# prettier (worktrees); fails rather than skipping when none is installed.
files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|html|css|scss|json|md)$')
[ -n "$files" ] || exit 0
prettier=node_modules/.bin/prettier
if [ ! -x "$prettier" ]; then
  primary=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
  prettier="$primary/node_modules/.bin/prettier"
fi
if [ ! -x "$prettier" ]; then
  echo "pre-commit: prettier not found — run npm ci, then commit again." >&2
  exit 1
fi
echo "$files" | tr '\n' '\0' | xargs -0 "$prettier" --write --ignore-unknown --log-level warn || exit 1
echo "$files" | tr '\n' '\0' | xargs -0 git add --
