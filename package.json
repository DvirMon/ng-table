{
  "name": "ng-table",
  "version": "0.0.0",
  "description": "Nx workspace for @ngp/table — a signal-based Angular table engine (libs/table) and its docs site (apps/site). Each project owns its own CONTEXT.md glossary and docs/adr/.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "npx nx serve ng-table",
    "table:sb": "npx nx run shared-table:storybook",
    "table:build-storybook": "npx nx run shared-table:build-storybook",
    "table:status": "node --experimental-strip-types libs/table/tools/generate-status.ts",
    "table:overloads": "node --experimental-strip-types libs/table/tools/generate-overloads.ts",
    "table:overloads:check": "node --experimental-strip-types libs/table/tools/generate-overloads.ts --check",
    "llms": "node --experimental-strip-types tools/generate-llms-txt.mts",
    "llms:check": "node --experimental-strip-types tools/generate-llms-txt.mts --check"
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@ng-icons/core": "^36.0.0",
    "@ng-icons/lucide": "^36.0.0",
    "ng-primitives": "^0.130.1",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.8",
    "@angular-devkit/core": "22.1.8",
    "@angular-devkit/schematics": "22.1.8",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@angular/language-service": "22.1.6",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "22.1.8",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/angular-vite": "10.6.0",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@types/node": "26.5.1",
    "@typescript-eslint/utils": "8.70.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^20.14.5",
    "jiti": "2.7.0",
    "jsdom": "~30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "nx": "23.2.1",
    "prettier": "~3.9.6",
    "storybook": "10.6.0",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.9"
  },
  "msw": {
    "workerDirectory": [
      "libs/table/public"
    ]
  }
}
