{
  "name": "ng-table",
  "version": "0.0.0",
  "description": "Nx workspace for @ngp/table — a signal-based Angular table engine (libs/table) and its docs site (apps/site). Each project owns its own CONTEXT.md glossary and docs/adr/.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "commits:check": "node tools/check-commit-trailers.cjs --range",
    "start": "npx nx serve ng-table",
    "lint": "npx nx run-many -t lint",
    "table:lint": "npx nx run shared-table:lint",
    "table:sb": "node tools/storybook-pick.mjs",
    "table:build-storybook": "npx nx run shared-table:build-storybook",
    "table:bench": "powershell -NoProfile -Command \"npx nx run shared-table:bench 2>&1 | Tee-Object -FilePath bench.log\"",
    "table:status": "node --experimental-strip-types libs/table/tools/generate-status.ts",
    "table:overloads": "node --experimental-strip-types libs/table/tools/generate-overloads.ts",
    "table:overloads:check": "node --experimental-strip-types libs/table/tools/generate-overloads.ts --check",
    "llms": "node --experimental-strip-types tools/generate-llms-txt.mts",
    "llms:check": "node --experimental-strip-types tools/generate-llms-txt.mts --check"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "ng-primitives": "^0.131.2",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.2",
    "@angular-devkit/core": "22.2.2",
    "@angular-devkit/schematics": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/language-service": "22.2.2",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/storybook": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@schematics/angular": "22.2.2",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular-vite": "10.6.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@types/node": "26.6.5",
    "@typescript-eslint/utils": "8.71.1",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/ui": "5.0.4",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^21.0.1",
    "jiti": "2.7.0",
    "jsdom": "~30.1.2",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.0",
    "nx": "23.3.0",
    "playwright": "^1.64.0",
    "prettier": "~3.9.10",
    "storybook": "10.6.1",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "msw": {
    "workerDirectory": [
      "libs/table/public"
    ]
  }
}
