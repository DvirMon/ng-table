{
  "name": "ng-table",
  "version": "0.0.0",
  "description": "Nx workspace for @ngp/table — a signal-based Angular table engine (libs/table) and its docs site (apps/site). Each project owns its own CONTEXT.md glossary and docs/adr/.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "commits:check": "node tools/check-commit-trailers.cjs --range",
    "start": "npx nx serve ng-table",
    "lint": "npx nx run-many -t lint",
    "table:lint": "npx nx run shared-table:lint",
    "table:sb": "node tools/storybook-pick.mjs",
    "table:build-storybook": "npx nx run shared-table:build-storybook",
    "table:bench": "powershell -NoProfile -Command \"npx nx run shared-table:bench 2>&1 | Tee-Object -FilePath bench.log\"",
    "table:status": "node --experimental-strip-types libs/table/tools/generate-status.ts",
    "table:overloads": "node --experimental-strip-types libs/table/tools/generate-overloads.ts",
    "table:overloads:check": "node --experimental-strip-types libs/table/tools/generate-overloads.ts --check",
    "llms": "node --experimental-strip-types tools/generate-llms-txt.mts",
    "llms:check": "node --experimental-strip-types tools/generate-llms-txt.mts --check",
    "site:content": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/site/tools/generate-content.mts",
    "site:content:check": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/site/tools/generate-content.mts --check"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "ng-primitives": "^0.132.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.3.0",
    "@angular-devkit/core": "22.3.0",
    "@angular-devkit/schematics": "22.3.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/storybook": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@schematics/angular": "22.3.0",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/angular-vite": "10.6.8",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.2",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@types/node": "26.6.6",
    "@typescript-eslint/utils": "8.74.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/ui": "5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^21.0.4",
    "jiti": "2.7.0",
    "jsdom": "~31.0.1",
    "marked": "^18.3.0",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.0",
    "nx": "24.0.6",
    "playwright": "^1.65.1",
    "prettier": "~3.10.1",
    "storybook": "10.6.8",
    "tslib": "^2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "libs/table/public"
    ]
  }
}
