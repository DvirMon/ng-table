{
  "name": "shared-table",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/table/src",
  "prefix": "ngp",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "ngc -p libs/table/tsconfig.lib.json --noEmit"
      }
    },
    "typecheck-spec": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "ngc -p libs/table/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/table",
        "browser": "libs/table/src/index.ts",
        "polyfills": [],
        "tsConfig": "libs/table/tsconfig.lib.json",
        "index": false
      },
      "configurations": {
        "production": {
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "watch": false,
        "exclude": ["**/*.bench.spec.ts"]
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "bench": {
      "executor": "@nx/angular:unit-test",
      "cache": false,
      "options": {
        "watch": false,
        "browsers": ["ChromiumHeadless"],
        "include": ["**/*.bench.spec.ts"]
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4403",
        "cwd": "libs/table"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/storybook/shared-table"],
      "options": {
        "command": "storybook build -o ../../dist/storybook/shared-table",
        "cwd": "libs/table"
      }
    }
  }
}
